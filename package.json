{
  "name": "mini-deck",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "pnpm build:packages && pnpm --filter @mini-deck/web build && pnpm --filter @mini-deck/collab build",
    "build:packages": "pnpm --filter @mini-deck/deck build && pnpm --filter @mini-deck/db build",
    "db:start": "tsx scripts/db-server.mts",
    "db:wait": "bash scripts/with-db.sh true",
    "storage:ensure": "tsx scripts/ensure-bucket.mts",
    "lint": "eslint .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && vitest run",
    "test:integration": "bash scripts/with-db.sh \"pnpm build:packages && vitest run --config vitest.integration.config.mts\"",
    "test:e2e": "bash scripts/with-db.sh \"pnpm build && playwright test\"",
    "test:container": "pnpm build:packages && node --test docker/test/*.test.mjs",
    "test:container:e2e": "playwright test --config playwright.container.config.ts",
    "ci:check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "db:generate": "pnpm --filter @mini-deck/db db:generate",
    "db:migrate": "bash scripts/db-migrate.sh",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down -v",
    "image:push": "bash scripts/push-image.sh",
    "smoke:api": "tsx scripts/api-smoke.mts",
    "db:stop": "bash scripts/db-stop.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@eslint/js": "^9.39.0",
    "@hocuspocus/provider": "^4.7.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "jsdom": "^27.2.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.0.5",
    "yjs": "^13.6.33"
  },
  "dependencies": {
    "http-proxy": "^1.18.1"
  }
}
