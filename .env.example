# Application
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234
COLLAB_WS_URL=ws://localhost:1234

# PostgreSQL (docker compose maps 5433 on the host)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/minideck

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=minideck
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Collaboration server
COLLAB_PORT=1234
COLLAB_DEBOUNCE_MS=2000
COLLAB_MAX_PAYLOAD_BYTES=5242880

# Rate limits (requests per minute)
DECK_CREATE_RATE_LIMIT=100
AUTH_FAILURE_RATE_LIMIT=60
IMAGE_SEARCH_RATE_LIMIT=60
IMAGE_IMPORT_RATE_LIMIT=30

# Deck access (PINs and join codes)
# Required in production: at least 32 characters, shared by web and collab.
# Development falls back to a documented dev-only value when unset.
DECK_SESSION_SECRET=
# Join-code lookups and unlock attempts per 15 minutes
JOIN_LOOKUP_RATE_LIMIT=20
JOIN_CODE_ATTEMPT_RATE_LIMIT=50
PIN_ATTEMPT_RATE_LIMIT=10
PIN_DECK_ATTEMPT_RATE_LIMIT=50

# Stock image providers (optional; leave blank to disable a provider)
# Unsplash: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=
